{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blogtony-comments",
  "main": "src/index.js",
  "compatibility_date": "2026-08-30",
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "blogtony-comments",
      "database_id": "PASTE_DATABASE_ID_HERE"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://tonykevin.neocities.org,http://127.0.0.1:5500,http://localhost:5500",
    "TURNSTILE_SITE_KEY": "PASTE_PUBLIC_SITE_KEY_HERE",
    "SITE_ORIGIN": "https://tonykevin.neocities.org"
  }
}
